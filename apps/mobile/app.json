{
  "expo": {
    "name": "PayMind",
    "slug": "paymind",
    "scheme": "paymind",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5F0",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.paymind.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["phonepe", "tez", "paytmmp", "bhim", "upi"]
      }
    },
    "android": {
      "package": "com.paymind.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6E1F1B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PayMind uses the camera to read bills you scan.",
          "photosPermission": "PayMind reads bill photos you choose to upload."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PayMind uses the microphone so you can say an expense.",
          "speechRecognitionPermission": "PayMind uses speech recognition to turn what you say into an expense."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ]
    ],
    "experiments": {}
  }
}
