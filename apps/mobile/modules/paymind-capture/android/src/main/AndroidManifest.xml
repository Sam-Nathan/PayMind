<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Android 11+ package visibility: without these entries queryIntentActivities() cannot see the
    UPI apps. The manifest merger copies this block into the app manifest.
  -->
  <queries>
    <!-- Any app that handles upi://pay -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="upi" />
    </intent>
    <package android:name="com.google.android.apps.nbu.paisa.user" />
    <package android:name="com.phonepe.app" />
    <package android:name="net.one97.paytm" />
    <package android:name="in.org.npci.upiapp" />
  </queries>

  <application>
    <!--
      Notification listener for payment alerts. It only receives anything once the user has granted
      "Notification access" in system settings (after our in-app disclosure), and it only keeps a
      notification when capture is switched on in Privacy, the package is on the allowlist in
      CaptureFilter.kt and the text looks like a completed transaction. We do NOT request READ_SMS.
    -->
    <service
      android:name="expo.modules.paymindcapture.PaymindNotificationListener"
      android:exported="true"
      android:label="PayMind payment alerts"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
